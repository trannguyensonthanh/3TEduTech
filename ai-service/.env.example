# ─────────────────────────────────────────────────────────────────────────────
# Sao chép thành `.env` rồi điền giá trị.
#
# [CẬP NHẬT] Tệp này trước đây đã lệch hẳn so với src/config.py: thiếu TOÀN BỘ
# biến thêm vào sau khi nó được viết (INTERNAL_API_KEY, LLM_PROVIDER, VLLM_*,
# GEMINI_ROUTING_*, GEMINI_CHAT_*, GEMINI_EMBEDDING_API_KEY, AI_SERVICE_WORKERS,
# WHISPER_CPU_THREADS). Lập trình viên sao chép tệp cũ sẽ nhận một cấu hình
# TRÔNG như đã đầy đủ nhưng chạy với xác thực TẮT.
# ─────────────────────────────────────────────────────────────────────────────

# ── Xác thực nội bộ ──────────────────────────────────────────────────────────
# Phải TRÙNG KHỚP với AI_SERVICE_INTERNAL_KEY phía backend Node.
# Để TRỐNG = mọi route /api chạy KHÔNG xác thực (chỉ nên dùng khi chạy local).
INTERNAL_API_KEY=

# Danh sách gốc được phép nhận webhook, phân tách bằng dấu phẩy.
# Webhook là lời gọi ngược về backend nên địa chỉ thường là nội bộ.
# Để trống = chấp nhận mọi gốc (kèm cảnh báo trong log).
WEBHOOK_ALLOWED_ORIGINS=http://localhost:5000

# ── Chọn mô hình ngôn ngữ ────────────────────────────────────────────────────
# "auto" = ưu tiên vLLM, tự chuyển sang Gemini khi vLLM không phản hồi.
# "gemini" | "qwen" để ép dùng một nhà cung cấp.
LLM_PROVIDER=gemini
LLM_GEMINI_COOLDOWN_SECONDS=900

# ── vLLM (máy GPU) ───────────────────────────────────────────────────────────
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_MODEL_NAME=Qwen/Qwen3.6-27B-AWQ
VLLM_API_KEY=not-needed
VLLM_TIMEOUT_SECONDS=180

# ── Gemini ───────────────────────────────────────────────────────────────────
# Khóa dùng chung; ba khóa chuyên biệt bên dưới sẽ ghi đè nếu được đặt.
GEMINI_API_KEY=
# ⚠️ GEMINI_MODEL KHÔNG được mã nguồn đọc tới — giữ lại chỉ để tương thích
#    ngược. Hãy dùng GEMINI_CHAT_MODEL.
GEMINI_ROUTING_API_KEY=
GEMINI_ROUTING_MODEL=gemini-2.5-flash-lite
GEMINI_CHAT_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# ── ChromaDB ─────────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_MASTER=master_knowledge
CHROMA_COLLECTION_COURSES=course_knowledge

# ── Máy chủ ──────────────────────────────────────────────────────────────────
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=2111
AI_SERVICE_WORKERS=1
# Danh sách origin cho CORS. Để "*" sẽ TẮT allow_credentials (trình duyệt từ
# chối cặp wildcard + credentials).
CORS_ORIGINS=http://localhost:8080,http://localhost:5000,https://localhost:8080
# Bật /docs, /redoc, /openapi.json. Mặc định tắt vì chúng nằm ngoài lớp xác thực.
ENABLE_API_DOCS=false

# ── RAG ──────────────────────────────────────────────────────────────────────
RAG_TOP_K=10
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200

# ── Whisper (phiên âm video) ─────────────────────────────────────────────────
# Chỉ có tác dụng khi image được dựng kèm `--build-arg INSTALL_EXTRAS=whisper`.
# Trên GPU EC2: WHISPER_DEVICE=cuda + WHISPER_COMPUTE_TYPE=float16.
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# 0 = để faster-whisper tự quyết số luồng.
WHISPER_CPU_THREADS=0

# ── Nhật ký ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
