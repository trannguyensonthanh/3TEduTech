// src/components/home/Hero.tsx
import { useNavigate } from 'react-router-dom';
import { motion } from 'framer-motion';
import { useTranslation } from 'react-i18next';
import { Button } from '@/components/ui/button';
import { Icons } from '../common/Icons';

/**
 * Dải mở đầu trang chủ.
 *
 * Bản trước đặt một nền tối riêng cho khối này kèm ba lớp trang trí chồng lên
 * nhau (mạch sáng SVG, hệ hạt WebGL, các quầng mờ) trong khi phần còn lại của
 * ứng dụng đang sáng. Nay chỉ còn một dải nền nhạt phân tách với phần dưới,
 * và đúng một sắc độ của màu nhấn cho cụm chữ được nhấn mạnh.
 */
const Hero = () => {
  const { t } = useTranslation();
  const navigate = useNavigate();

  const textVariants = {
    hidden: { opacity: 0, y: 20 },
    visible: (i: number) => ({
      opacity: 1,
      y: 0,
      transition: {
        delay: i * 0.15 + 0.3,
        duration: 0.6,
        ease: 'easeOut',
      },
    }),
  };

  const buttonVariants = {
    hidden: { opacity: 0, scale: 0.8 },
    visible: {
      opacity: 1,
      scale: 1,
      transition: {
        delay: 0.8,
        duration: 0.5,
        ease: 'easeOut',
      },
    },
  };

  const statsVariants = {
    hidden: { opacity: 0, y: 30 },
    visible: {
      opacity: 1,
      y: 0,
      transition: {
        delay: 1.2,
        duration: 0.6,
        ease: 'easeOut',
      },
    },
  };

  const statCounterVariants = {
    hidden: { scale: 0 },
    visible: (i: number) => ({
      scale: 1,
      transition: {
        delay: 1.4 + i * 0.15,
        duration: 0.5,
        type: 'spring',
        stiffness: 200,
      },
    }),
  };

  const stats = [
    { value: '500+', label: t('hero.statCourses', 'Khóa học đang mở') },
    { value: '10K+', label: t('hero.statStudents', 'Học viên đang học') },
    { value: '4.8', label: t('hero.statRating', 'Điểm đánh giá trung bình') },
  ];

  return (
    <section className='border-b border-border bg-muted/40'>
      <div className='container mx-auto px-4 py-16 sm:px-6 md:py-24 lg:px-8'>
        <div className='grid grid-cols-1 items-center gap-10 lg:grid-cols-12 lg:gap-12'>
          {/* Cột chữ */}
          <motion.div
            initial='hidden'
            animate='visible'
            className='text-center lg:col-span-7 lg:text-left'
          >
            <motion.h1
              custom={0}
              variants={textVariants}
              className='text-3xl font-semibold tracking-tight sm:text-4xl'
            >
              {t('hero.title1')}
              <br className='hidden md:block' />
              {t('hero.title2a')}
              <span className='text-primary'>{t('hero.title2b')}</span>
              {t('hero.title2c')}
            </motion.h1>

            <motion.p
              custom={1}
              variants={textVariants}
              className='mx-auto mt-4 max-w-xl text-base text-muted-foreground md:text-lg lg:mx-0'
            >
              {t('hero.desc')}
            </motion.p>

            <motion.div
              custom={2}
              variants={buttonVariants}
              className='mt-8 flex flex-col justify-center gap-3 sm:flex-row lg:justify-start'
            >
              <Button size='lg' onClick={() => navigate('/courses')}>
                {t('hero.ctaExplore')}
                <Icons.arrowRight className='ml-2 h-4 w-4' aria-hidden='true' />
              </Button>
              <Button
                size='lg'
                variant='outline'
                onClick={() => navigate('/instructor/register')}
              >
                {t('hero.ctaInstructor')}
              </Button>
            </motion.div>

            <motion.ul
              custom={3}
              variants={textVariants}
              className='mt-10 space-y-3 text-sm'
            >
              {['hero.bullet1', 'hero.bullet2', 'hero.bullet3'].map((key) => (
                <li
                  key={key}
                  className='flex items-center justify-center lg:justify-start'
                >
                  <span className='mr-3 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary'>
                    <Icons.check className='h-3 w-3' aria-hidden='true' />
                  </span>
                  <span className='text-muted-foreground'>{t(key)}</span>
                </li>
              ))}
            </motion.ul>
          </motion.div>

          {/* Cột hình minh họa */}
          <motion.div
            initial={{ opacity: 0, scale: 0.97 }}
            animate={{ opacity: 1, scale: 1 }}
            transition={{ delay: 0.5, duration: 0.8, ease: 'easeOut' }}
            className='hidden lg:col-span-5 lg:block'
          >
            <img
              src='https://images.unsplash.com/photo-1516321497487-e288fb19713f?q=80&w=2070&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D'
              alt='Học viên học trực tuyến trên nền tảng 3TEduTech'
              className='aspect-[4/3] w-full rounded-xl border border-border object-cover'
              loading='lazy'
            />
          </motion.div>
        </div>

        {/* Dải số liệu */}
        <motion.div
          variants={statsVariants}
          initial='hidden'
          animate='visible'
          className='mt-14 grid max-w-3xl grid-cols-3 gap-8 border-t border-border pt-8'
        >
          {stats.map((stat, i) => (
            <motion.div
              key={stat.label}
              custom={i}
              variants={statCounterVariants}
              className='text-center lg:text-left'
            >
              <p className='text-2xl font-semibold tabular-nums tracking-tight sm:text-3xl'>
                {stat.value}
              </p>
              <p className='mt-1 text-sm text-muted-foreground'>{stat.label}</p>
            </motion.div>
          ))}
        </motion.div>
      </div>
    </section>
  );
};

export default Hero;
