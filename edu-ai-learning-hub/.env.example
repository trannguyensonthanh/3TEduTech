# ─────────────────────────────────────────────────────────────────────────────
# Sao chép tệp này thành `.env` rồi chỉnh cho máy của bạn.
#
# Vì sao cần: trước đây dự án KHÔNG có tệp .env nào, nên import.meta.env.VITE_API_URL
# luôn là undefined và 13 chỗ trong mã nguồn rơi về chuỗi dự phòng cứng
# `http://<hostname>:5000/v1`. Khi trang chạy qua HTTPS (repo có sẵn
# localhost.crt/localhost.key) thì trình duyệt CHẶN các lời gọi http:// đó vì
# nội dung hỗn hợp.
# ─────────────────────────────────────────────────────────────────────────────

# API của backend, bao gồm cả tiền tố phiên bản.
VITE_API_URL=http://localhost:5000/v1

# API của AI Service.
VITE_AI_API_URL=http://localhost:2111
