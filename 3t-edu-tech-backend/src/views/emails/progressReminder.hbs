<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Tiếp tục khóa học của bạn</title>
  </head>
  <!-- Bảng lồng bảng + CSS inline: bắt buộc với email HTML (xem ghi chú trong
       certificateIssued.hbs). Thanh tiến độ cũng phải dựng bằng <table> vì
       Outlook không hiểu div có width theo phần trăm lồng trong div. -->
  <body style="margin:0; padding:0; background-color:#f1f5f9; font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f1f5f9; padding:32px 12px;">
      <tr>
        <td align="center">
          <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="max-width:600px; width:100%; background-color:#ffffff; border-radius:16px; overflow:hidden; box-shadow:0 2px 12px rgba(15,23,42,0.08);">

            <tr>
              <td style="background: linear-gradient(90deg, #0ea5e9 0%, #6366f1 100%); padding:4px 0;"></td>
            </tr>

            <tr>
              <td style="padding:32px 32px 8px 32px;">
                <h1 style="margin:0 0 8px 0; color:#0f172a; font-size:22px; font-weight:700;">
                  Chào {{fullNameOrDefault}}, quay lại học tiếp nhé! 📚
                </h1>
                <p style="margin:0; color:#64748b; font-size:14px;">
                  Bạn đang bỏ dở khóa học <strong style="color:#0f172a;">{{courseName}}</strong>.
                </p>
              </td>
            </tr>

            <!-- Lời nhắn do AI viết riêng cho học viên -->
            <tr>
              <td style="padding:20px 32px 4px 32px;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f0f9ff; border-left:4px solid #0ea5e9; border-radius:8px;">
                  <tr>
                    <td style="padding:16px 20px; color:#0c4a6e; font-size:15px; line-height:1.7;">
                      {{aiMessage}}
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Thanh tiến độ -->
            <tr>
              <td style="padding:24px 32px 8px 32px;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                  <tr>
                    <td style="color:#475569; font-size:13px; font-weight:600; padding-bottom:8px;">
                      Tiến độ hiện tại
                    </td>
                    <td align="right" style="color:#0ea5e9; font-size:13px; font-weight:700; padding-bottom:8px;">
                      {{progressPercent}}% &middot; {{completedLessons}}/{{totalLessons}} bài
                    </td>
                  </tr>
                </table>

                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#e2e8f0; border-radius:999px; height:10px;">
                  <tr>
                    <td style="padding:0;">
                      <table role="presentation" width="{{progressPercent}}%" cellpadding="0" cellspacing="0" style="border-radius:999px;">
                        <tr>
                          <td style="background: linear-gradient(90deg, #0ea5e9, #6366f1); height:10px; border-radius:999px; font-size:0; line-height:0;">&nbsp;</td>
                        </tr>
                      </table>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <tr>
              <td align="center" style="padding:28px 32px 32px 32px;">
                <table role="presentation" cellpadding="0" cellspacing="0">
                  <tr>
                    <td style="border-radius:10px; background:#0ea5e9;">
                      <a href="{{continueUrl}}" target="_blank"
                         style="display:inline-block; padding:14px 32px; color:#ffffff; font-size:15px; font-weight:600; text-decoration:none; border-radius:10px;">
                        Học tiếp ngay
                      </a>
                    </td>
                  </tr>
                </table>
                <p style="margin:18px 0 0 0; color:#94a3b8; font-size:12px; line-height:1.6;">
                  Bạn nhận email này vì đang có khóa học chưa hoàn thành tại {{appName}}.<br />
                  Chúng tôi chỉ nhắc lại sau nhiều ngày, không gửi hằng ngày.
                </p>
              </td>
            </tr>

          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
