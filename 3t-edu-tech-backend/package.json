{
  "name": "3t-edu-tech-backend",
  "version": "1.0.0",
  "description": "Backend for the online learning platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon --watch .env --watch . server.js",
    "test": "jest --config tests/jest.config.js --runInBand",
    "test:smoke": "jest --config tests/jest.config.js --runInBand --testPathPatterns=00-smoke",
    "test:auth": "jest --config tests/jest.config.js --testPathPatterns=\"0[01]\"",
    "test:quick": "jest --config tests/jest.config.js --runInBand --testPathPatterns=\"0[0-4]\"",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\" \"*.js\"",
    "test:core": "jest --config tests/jest.config.js --runInBand --testPathPatterns=\"0(0|1)\"",
    "test:courses": "jest --config tests/jest.config.js --runInBand --testPathPatterns=\"(01b|12-|14-)\"",
    "test:import": "jest --config tests/jest.config.js --runInBand --testPathPatterns=\"(01b|15-)\"",
    "test:ai": "jest --config tests/jest.config.js --runInBand --testPathPatterns=\"(01b|11-|16-)\"",
    "test:reports": "jest --config tests/jest.config.js --runInBand --testPathPatterns=\"(01b|17-)\"",
    "test:orders": "jest --config tests/jest.config.js --runInBand --testPathPatterns=\"(01b|05-|18-)\"",
    "test:learn": "jest --config tests/jest.config.js --runInBand --testPathPatterns=\"(01b|06-|09-|19-)\"",
    "test:edge": "jest --config tests/jest.config.js --runInBand --testPathPatterns=\"(01b|20-)\"",
    "test:security": "jest --config tests/jest.config.js --runInBand --testPathPatterns=\"(01b|17-|19-|20-)\""
  },
  "keywords": [
    "nodejs",
    "express",
    "sql-server",
    "learning",
    "api"
  ],
  "author": "Your Name <sonthanh12345678910@gmail.com>",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.9.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.81.2",
    "cloudinary": "^2.6.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "decimal.js": "^10.5.0",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-handlebars": "^8.0.1",
    "google-auth-library": "^9.15.1",
    "helmet": "^8.1.0",
    "http-status": "^2.1.0",
    "ioredis": "^5.6.1",
    "joi": "^17.13.3",
    "joi-objectid": "^4.0.2",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "moment-timezone": "^0.5.48",
    "morgan": "^1.10.0",
    "mssql": "^11.0.1",
    "multer": "^1.4.5-lts.2",
    "node-cron": "^4.0.0",
    "nodemailer": "^6.10.1",
    "nodemailer-express-handlebars": "^7.0.0",
    "qs": "^6.14.0",
    "slugify": "^1.6.6",
    "stripe": "^18.2.1",
    "uuid": "^11.1.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.6",
    "jest": "^30.4.2",
    "nodemon": "^3.1.10",
    "prettier": "^3.5.3",
    "supertest": "^7.2.2"
  }
}
