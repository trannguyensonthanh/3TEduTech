# =============================================================================
# https-server.conf.template — bản có HTTPS
# =============================================================================
# [THÊM 18/08/2026]
#
# ⚠️ ĐỪNG chép tay tệp này vào conf.d. Dùng script:
#
#     sudo bash scripts/bat-https.sh <ten-mien-cua-ban>
#
# Script thay `__DOMAIN__` bằng tên miền thật, đặt kết quả vào
# nginx/conf.d/default.conf, kiểm tra cú pháp rồi mới nạp lại nginx.
#
# ⚠️ Tên tệp KẾT THÚC BẰNG `.template`, không phải `.conf`, và nằm NGOÀI thư mục
# conf.d — nếu không nginx sẽ tự nạp nó, gặp `__DOMAIN__` không phải tên miền
# hợp lệ trong đường dẫn chứng chỉ và thoát ngay lúc khởi động.
# =============================================================================

# ---------------------------------------------------------------
# Cổng 80: chuyển hướng sang HTTPS, TRỪ đường dẫn ACME.
#
# ★ Vì sao ACME phải được loại trừ: Let's Encrypt gia hạn chứng chỉ bằng cách
# gọi http://<ten-mien>/.well-known/acme-challenge/<token> qua CỔNG 80. Nếu
# chuyển hướng toàn bộ cổng 80 sang HTTPS thì lần gia hạn 90 ngày sau sẽ thất
# bại — và nó thất bại lúc 3 giờ sáng khi không ai nhìn. Chứng chỉ hết hạn,
# trình duyệt báo "không an toàn", và không ai hiểu vì sao vì hôm qua vẫn chạy.
#
# (Thực ra Let's Encrypt CÓ theo chuyển hướng 301 sang HTTPS, nhưng chỉ khi
# chứng chỉ hiện tại còn hợp lệ. Đúng lúc chứng chỉ đã hỏng thì vòng lặp khép
# lại: cần HTTPS để gia hạn, cần gia hạn để có HTTPS.)
# ---------------------------------------------------------------
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }

    # Healthcheck của Docker gọi qua cổng 80 từ bên trong container. PHẢI khai
    # báo lại ở đây (khối này không include locations.inc): nếu để nó rơi vào
    # `location /` bên dưới, healthcheck nhận 301 tới https://localhost — không
    # khớp chứng chỉ — và container bị đánh dấu "unhealthy" vĩnh viễn.
    location = /nginx-health {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    # `http2 on` là cú pháp của Nginx 1.25 trở lên. Cách viết cũ
    # `listen 443 ssl http2;` đã bị đánh dấu lỗi thời và sinh cảnh báo.
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    http2 on;

    server_name __DOMAIN__;

    # Đường dẫn do certbot tạo trên MÁY CHỦ; container frontend mount
    # /etc/letsencrypt ở chế độ chỉ đọc (xem docker-compose.cpu-ec2.yml).
    ssl_certificate     /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;

    # Chỉ TLS 1.2 và 1.3. TLS 1.0/1.1 đã bị mọi trình duyệt lớn loại bỏ và chỉ
    # còn là bề mặt tấn công.
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;   # Với TLS1.3, để client chọn là tốt hơn
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;

    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # ⚠️ HSTS — ĐỌC TRƯỚC KHI BẬT
    #
    # Dòng dưới bảo trình duyệt "trong 1 năm tới, KHÔNG BAO GIỜ nói chuyện với
    # tên miền này qua HTTP". Đây là thứ KHÔNG RÚT LẠI ĐƯỢC từ phía máy chủ:
    # nếu chứng chỉ hết hạn hoặc bạn đổi sang tên miền khác, người dùng đã ghé
    # thăm sẽ bị trình duyệt CHẶN hẳn, không có nút "vẫn tiếp tục".
    #
    # Chỉ bỏ comment khi HTTPS đã chạy ổn định vài tuần và việc tự động gia hạn
    # đã được chứng minh là hoạt động (xem `certbot renew --dry-run`).
    # add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;
    gzip_min_length 1000;

    # ★ CÙNG MỘT TỆP với bản HTTP. Đây là điểm mấu chốt: bản cũ chép tay các
    # location sang khối HTTPS và làm rơi mất /socket.io/ lẫn /v1/events/, nên
    # bật SSL xong là chat realtime chết mà không có lỗi nào chỉ ra nguyên nhân.
    include /etc/nginx/conf.d/locations.inc;
}
